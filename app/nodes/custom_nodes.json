        "skill_file": "J:/MagicTool/个人网站/tools/节点技能库/公众号上传/SKILL.md",
        "mode": "script",
        "runtime": [
          "py",
          "-3.13"
        ],
        "script": "scripts/publish_article.py",
        "args": [
          "--file",
          "{input}",
          "--cover",
          "{param:封面}",
          "--author",
          "{param:作者}"
